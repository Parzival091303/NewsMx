---
import LayoutBase from "@/layouts/LayoutBase.astro";





import Bloque2 from "@/componentes/bloques/Bloque2.astro";
import Bloque3 from "@/componentes/bloques/Bloque3.astro";
import Bloque4 from "@/componentes/bloques/Bloque4.astro";
---


<LayoutBase>

    <!-- CARRUSEL DE LAS 6 CATEGORIAS CON  MAS NOTICIAS -->
<Bloque2 />

<!--SECCION DE LAS NOTICIAS MAS NUEVAS  -->
<Bloque3 />

  <!-- BANNER -->
  <section class="mega-banner">
    <div class="banner-content">
      <h1>¡LO MÁS NUEVO!</h1>
      <h2>Nuevas categorías de noticias</h2>
    </div>
  </section>
<!--BLOQUE DE CATEGORIAS DE NOTICDIAS -->
<Bloque4 />
 
</LayoutBase>


<style>

.carousel-section {
  margin: 100px 0 200px 0;
}

.mega-banner {
  max-width: 1200px;
  margin: 150px auto 50px auto; /* separación inferior */
  background: linear-gradient(to right, #1e6f8a, #2da385);
  padding: 80px 60px 60px 60px;
  text-align: center;
  color: white;
  border-radius: 4px;
}


.mega-banner h1 {
  font-size: 7rem;
  font-weight: bolder;
  font-family: "Helvetica Neue", sans-serif, Arial;
  text-shadow: rgba(0, 0, 0, 0.2) 0px 4px 15px;
}

.mega-banner h2 {
  font-size: 1.5rem;
  font-family: Montserrat, sans-serif, Arial;
  font-weight: bolder;
}

/* Categorías */
.categories-section {
  max-width: 1200px;
  margin: 0 auto 80px auto;
}

.categories-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 8px;
}

.category-card {
  position: relative;
  height: 140px;
  background-size: cover;
  background-position: center;
  cursor: pointer;
  overflow: visible;
}

.category-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.55);
  transition: 0.3s;
}

.category-card:hover::after {
  background: rgba(0,0,0,0.3);
  transform: scale(110%);
}

.category-card span {
  position: absolute;
  bottom: 10px;
  left: 10px;
  color: white;
  font-weight: bold;
  font-size: 0.9rem;
  z-index: 2;
}

/*  RESPONSIVE */

@media (max-width: 1200px) {
  .categories-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

@media (max-width: 900px) {
  .categories-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 600px) {
  .categories-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

</style>



