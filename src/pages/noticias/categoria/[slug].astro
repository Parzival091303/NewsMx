---
export const prerender = false;
import LayoutBase from "@/layouts/LayoutBase.astro";
import { actions } from "astro:actions";
import { prisma } from "@/db";

const { slug } = Astro.params;
const offset = Number(Astro.url.searchParams.get("offset") ?? 0);
const LIMIT = 10;

// Convertir slug a nombre de categoría
function deslugify(slug: string) {
  return slug.replace(/-/g, " ");
}

// Buscar categoría por nombre aproximado
const todasCategorias = await prisma.categorias.findMany();
const categoria = todasCategorias.find(c =>
  c.nombre_categoria.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/\s+/g, "-") === slug
);

if (!categoria) {
  return Astro.redirect("/");
}

const nombreCategoria = categoria.nombre_categoria;

const { data } = await Astro.callAction(actions.getNewsByCategory, {
  category: nombreCategoria,
  offset,
  limit: LIMIT,
});

const news = data?.news ?? [];
const pagination = data?.pagination;

function formatFecha(fecha: Date | null) {
  if (!fecha) return "";
  return new Date(fecha.getTime() + 6 * 60 * 60 * 1000).toLocaleDateString("es-MX", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  });
}
---

<LayoutBase>
  <div class="categoria-page">

    <!-- HEADER -->
    <div class="categoria-header">
      <h1>{nombreCategoria.toUpperCase()}</h1>
      <div class="categoria-divider"></div>
    </div>

    <!-- CONTENIDO -->
    <div class="categoria-layout">

      <!-- LISTA DE NOTICIAS -->
      <div class="noticias-lista">
        {news.length === 0 && (
          <p class="sin-noticias">No hay noticias en esta categoría.</p>
        )}

        {news.map((n: any) => (
          <a href={`/noticias/${n.noticias_url}`} class="noticia-card">
            <div class="noticia-img">
              {n.imagen ? (
                <img src={n.imagen} alt={n.titulo_noticia ?? ""} />
              ) : (
                <div class="noticia-img-placeholder">📰</div>
              )}
            </div>
            <div class="noticia-body">
              <div class="noticia-meta">
                {formatFecha(n.fecha_noticia)}
                {n.categorias?.length > 0 && (
                  <span> | {n.categorias[0].categoria.nombre_categoria}</span>
                )}
              </div>
              <h2>{n.titulo_noticia}</h2>
              {n.usuario && (
                <p class="noticia-autor">Por {n.usuario.nombre} {n.usuario.apellido}</p>
              )}
              <span class="continue-reading">Continue Reading</span>
            </div>
          </a>
        ))}

        <!-- PAGINACIÓN -->
        {pagination && pagination.totalPages > 1 && (
          <div class="paginacion">
            {pagination.hasPrevious ? (
              <a href={`?offset=${offset - LIMIT}`} class="page-btn">← Anterior</a>
            ) : (
              <span class="page-btn disabled">← Anterior</span>
            )}
            <span class="page-info">Página {pagination.currentPage} de {pagination.totalPages}</span>
            {pagination.hasNext ? (
              <a href={`?offset=${offset + LIMIT}`} class="page-btn">Siguiente →</a>
            ) : (
              <span class="page-btn disabled">Siguiente →</span>
            )}
          </div>
        )}
      </div>

      <!-- SIDEBAR -->
      <aside class="sidebar">
        <h3>Categories</h3>
        <ul>
       
          {todasCategorias.map(c => (
            <li>
              <a href={`/noticias/categoria/${c.nombre_categoria.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/\s+/g, "-")}`}
                class={c.nombre_categoria === nombreCategoria ? "active" : ""}>
                {c.nombre_categoria}
              </a>
            </li>
          ))}
        </ul>
      </aside>

    </div>
  </div>
</LayoutBase>

<style>
  .categoria-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 20px 80px;
    font-family: 'Inter', sans-serif;
  }

  .categoria-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .categoria-header h1 {
    font-size: 2.2rem;
    font-weight: 800;
    color: #008489;
    letter-spacing: 2px;
  }

  .categoria-divider {
    width: 60px;
    height: 3px;
    background: #008489;
    margin: 12px auto 0;
    border-radius: 2px;
  }

  .categoria-layout {
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: 40px;
    align-items: start;
  }

  /* NOTICIAS */
  .noticia-card {
    display: flex;
    gap: 20px;
    margin-bottom: 40px;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid #eee;
    padding-bottom: 40px;
  }

  .noticia-card:last-of-type {
    border-bottom: none;
  }

  .noticia-img {
    flex-shrink: 0;
    width: 160px;
    height: 120px;
    overflow: hidden;
    border-radius: 4px;
  }

  .noticia-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .noticia-card:hover .noticia-img img {
    transform: scale(1.05);
  }

  .noticia-img-placeholder {
    width: 100%;
    height: 100%;
    background: #f0fafa;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
  }

  .noticia-body {
    flex: 1;
  }

  .noticia-meta {
    font-size: 0.8rem;
    color: #888;
    margin-bottom: 8px;
  }

  .noticia-body h2 {
    font-size: 1.2rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 6px;
    line-height: 1.4;
    transition: color 0.2s;
  }

  .noticia-card:hover h2 {
    color: #008489;
  }

  .noticia-autor {
    font-size: 0.85rem;
    color: #555;
    margin-bottom: 8px;
  }

  .continue-reading {
    font-size: 0.85rem;
    color: #008489;
    font-weight: 600;
  }

  .sin-noticias {
    color: #888;
    text-align: center;
    padding: 3rem;
  }

  /* PAGINACIÓN */
  .paginacion {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid #eee;
  }

  .page-btn {
    background: #fff;
    border: 1px solid #c0e8e8;
    color: #0f4f4f;
    padding: 0.5rem 1.2rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s;
  }

  .page-btn:hover {
    background: #e6f7f7;
    border-color: #2aa3a3;
  }

  .page-btn.disabled {
    opacity: 0.35;
    pointer-events: none;
  }

  .page-info {
    font-size: 0.8rem;
    color: #999;
  }

  /* SIDEBAR */
  .sidebar h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 2px solid #eee;
  }

  .sidebar ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar ul li {
    margin-bottom: 10px;
  }

  .sidebar ul li a {
    font-size: 0.9rem;
    color: #444;
    text-decoration: none;
    transition: color 0.2s;
  }

  .sidebar ul li a:hover,
  .sidebar ul li a.active {
    color: #008489;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .categoria-layout {
      grid-template-columns: 1fr;
    }
    .noticia-img {
      width: 100px;
      height: 80px;
    }
  }
</style>