---
import "@/styles/global.css";
import NewsCard from "@/componentes/NewsCard.astro";
import { actions } from "astro:actions";
import LayoutBase from "@/layouts/LayoutBase.astro";

const slug  = Astro.params.slug!;

const { data : noticia, error } = await Astro.callAction(actions.getNewsBySlug, { slug });


if (!noticia || error) {
  throw new Error("Noticia no encontrada" + (error ? `: ${error.message}` : ""));
}
---

<LayoutBase>
  <NewsCard noticia={noticia} />
</LayoutBase>