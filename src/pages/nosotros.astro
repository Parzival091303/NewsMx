---
export const prerender = false;
import LayoutBase from "@/layouts/LayoutBase.astro";

/* Datos para las tarjetas del equipo (como tu imagen) */
const areasEquipo = [
    {
        area: "TALENTO",
        areaColor: "#00c2d1",
        titulo: "Conductores",
        nombre: "Karla M. Vázquez",
        rol: "Conductora",
        foto: "img/karvaz.png",
    },
    {
        area: "PRODUCCIÓN",
        areaColor: "#b9ff00",
        titulo: "Productores",
        nombre: "Sergio Pérez",
        rol: "Conductor y Productor",
        foto: "img/serper.png",
    },
    {
        area: "EDITORIAL",
        areaColor: "#ff008f",
        titulo: "Redactores",
        nombre: "Itzel Zamorano",
        rol: "Redactora",
        foto: "img/itzzam.png",
    },
    {
        area: "ESTRATEGIA",
        areaColor: "#00c2d1",
        titulo: "Marketing",
        nombre: "Alonso Manqueros",
        rol: "Coordinador MKT",
        foto: "img/aloman.png",
    },
];
---

<LayoutBase>
    <section class="maximalist-hero">
        <div class="noise-bg"></div>
        <div class="hero-bg-text">NEWS MX</div>
        <div class="floating-shape shape-1"></div>
        <div class="floating-shape shape-2"></div>
        <div class="floating-shape shape-3"></div>

        <!-- Y2K DECOR -->
        <div class="y2k-star star-1">✦</div>
        <div class="y2k-star star-2">✦</div>

        <div class="hero-content">
        <h1 class="hero-title">
            <span class="reveal-text" style="--delay: 0.1s">
            <span class="glitch-text" data-text="SOMOS">SOMOS</span>
            </span>
            <span class="reveal-text highlight italic" style="--delay: 0.3s">HISTORIA</span><br />
            <span class="reveal-text outline-alt vertical" style="--delay: 0.5s">EN TIEMPO REAL</span>
        </h1>
        <div class="hero-sticker floating-sticker">EST. 2008</div>
        <p class="hero-subtitle reveal-text" style="--delay: 0.7s">PERIODISMO INDEPENDIENTE • MÉXICO</p>
        </div>
        <div class="scroll-indicator">
        <div class="mouse"></div>
        <span class="scroll-text"></span>
        </div>
    </section>

    <section class="modern-content">
        <div class="noise-bg"></div>
        <div class="aesthetic-header">
        <span class="line"></span>
        <div class="section-tag">INSTITUCIONAL</div>
        <span class="line"></span>
        </div>

        <div class="modern-grid">
        <!-- HISTORIA -->
        <div class="modern-card card-large card-history">
            <div class="card-content">
            <div class="card-header-flex">
                <span class="card-tag">01 / ORIGEN</span>
                <div class="aesthetic-dot"></div>
            </div>
            <h2 class="modern-title">Nuestra <span class="text-teal underline-aesthetic">Trayectoria</span></h2>
            <div class="text-block">
                <p class="lead-modern">
                NewsMx Tv es un proyecto que tiene origen en el año 2008, resultado de la ambición de dos jóvenes
                profesionales recién egresados de la licenciatura en periodismo,
                <span class="name-badge-alt">Jeannette Gutiérrez Rodríguez</span> y
                <span class="name-badge-alt">David Hernández Cortés</span>.
                </p>
                <p class="body-modern">
                Ellos tenían el sueño y la determinación de competir en un ecosistema periodístico dominado cada vez más
                por las grandes cadenas. Lo que comenzó como un sueño compartido se ha transformado en un referente de
                independencia informativa.
                </p>
            </div>
            </div>
        </div>

        <!-- MISIÓN Y VISIÓN -->
        <div class="modern-card card-medium card-purpose">
            <div class="card-content">
            <span class="card-tag">02 / PROPÓSITO</span>
            <h2 class="modern-title">Misión <span class="text-outline-alt">&</span> Visión</h2>

            <div class="purpose-items">
                <div class="purpose-item-alt">
                <div class="item-id">M</div>
                <div class="item-info">
                    <h3>MISIÓN</h3>
                    <p>Proveer información clara y veraz, fomentando la participación ciudadana y la conciencia social.</p>
                </div>
                </div>

                <div class="purpose-item-alt">
                <div class="item-id yellow">V</div>
                <div class="item-info">
                    <h3>VISIÓN</h3>
                    <p>
                    Consolidar a NewsMx TV como el medio digital de referencia, alcanzando
                    <span class="stat-highlight-alt">500,000 usuarios</span> para el 2028.
                    </p>
                </div>
                </div>
            </div>
            </div>
        </div>

        <!-- EVOLUCIÓN -->
        <div class="modern-card card-small card-growth">
            <div class="card-content">
            <div class="growth-header">
                <span class="card-tag">03 / EVOLUCIÓN</span>
            </div>
            <div class="stat-container">
                <div class="stat-big-alt">17+</div>
                <div class="stat-years">YEARS</div>
            </div>
            <p class="body-small-alt">Equipo de <span class="highlight-mini">30+ integrantes</span> comprometidos con la veracidad.</p>
            </div>
        </div>

        <!-- SECCIÓN VALORES -->
        <div class="values-section modern-card card-full reveal-text" style="--delay: 0.5s">
            <div class="values-header-alt">
            <h2 class="values-title-main">VALORES</h2>
            <div class="values-info-alt">
                <span>NEWSMX TV</span>
                <span class="text-teal">CORE VALUES // 2028</span>
            </div>
            </div>

            <div class="values-grid-alt">
            <div class="value-card-alt">
                <div class="value-ghost-text">TRN</div>
                <div class="value-inner">
                <span class="value-tag-alt">01 // NEWSMX</span>
                <h3 class="value-name-alt">TRANSPARENCIA</h3>
                <p class="value-description-alt">Comprometidos con la verdad y la ética periodística.</p>
                </div>
            </div>

            <div class="value-card-alt">
                <div class="value-ghost-text">DVR</div>
                <div class="value-inner">
                <span class="value-tag-alt">02 // NEWSMX</span>
                <h3 class="value-name-alt">DIVERSIDAD</h3>
                <p class="value-description-alt">Inclusión de múltiples voces y perspectivas.</p>
                </div>
            </div>

            <div class="value-card-alt">
                <div class="value-ghost-text">INV</div>
                <div class="value-inner">
                <span class="value-tag-alt">03 // NEWSMX</span>
                <h3 class="value-name-alt">INNOVACIÓN</h3>
                <p class="value-description-alt">Adaptación a nuevas tecnologías y formatos de comunicación.</p>
                </div>
            </div>

            <div class="value-card-alt">
                <div class="value-ghost-text">EMP</div>
                <div class="value-inner">
                <span class="value-tag-alt">04 // NEWSMX</span>
                <h3 class="value-name-alt">EMPODERAMIENTO</h3>
                <p class="value-description-alt">Fomentando el diálogo y la participación ciudadana.</p>
                </div>
            </div>
            </div>
        </div>

        <!-- SECCIÓN POLÍTICAS PÚBLICAS -->
        <div class="policies-section modern-card card-full reveal-text" style="--delay: 0.2s">
            <div class="policy-layout-alt">
            <div class="policy-sidebar-alt">
                <div class="policy-vertical-tag">
                <span>NEWSMX TV</span>
                <span>INSTITUTIONAL DOCUMENT</span>
                <span class="text-teal">2026</span>
                </div>
            </div>

            <div class="policy-main-alt">
                <div class="policy-header-alt">
                <span class="policy-line-top"></span>
                <h2 class="policy-title-alt">
                    PROYECTO DE <br />
                    <span class="text-teal">POLÍTICAS PÚBLICAS</span>
                </h2>
                <p class="policy-tagline-alt">COMPROMISO • TRANSPARENCIA • ÉTICA</p>
                </div>

                <div class="policy-body-alt">
                <div class="policy-intro-alt">
                    <span class="policy-id-box">01</span>
                    <p>
                    Nuestra misión se fundamenta en informar con responsabilidad y compromiso social, desarrollando
                    políticas orientadas al fortalecimiento de la ética periodística y la transparencia informativa.
                    </p>
                </div>

                <blockquote class="policy-quote-alt">
                    <p>
                    "Asumimos el compromiso de consolidarnos como una voz confiable que contribuye al fortalecimiento de
                    una ciudadanía informada, crítica y participativa."
                    </p>
                    <div class="policy-quote-line"></div>
                </blockquote>
                </div>
            </div>
            </div>

            <div class="policy-footer-alt">
            <div class="policy-logo-text">NewsMx<span>TV</span></div>
            <div class="policy-deco-squares">
                <span></span><span></span><span></span>
            </div>
            </div>
        </div>
        </div>

        <section class="team-cards-section">
        <div class="team-cards-container">
            <div class="team-cards-grid">
            {areasEquipo.map((p) => (
                <article class="team-card">
                <button class="team-card-btn" style={`background:${p.areaColor};`} aria-label={`Ir a ${p.titulo}`}>
                    →
                </button>

                <div class="team-card-photoWrap">
                    <div class="team-card-ring"></div>
                    <img class="team-card-photo" src={p.foto} alt={p.nombre} />
                </div>

                <div class="team-card-info">
                    <h3 class="team-card-name">{p.nombre}</h3>
                    <p class="team-card-role">{p.rol}</p>
                    <p class="team-card-area" style={`color:${p.areaColor};`}>{p.area}</p>
                </div>

                <h2 class="team-card-title">{p.titulo}</h2>
                </article>
            ))}
            </div>
        </div>
        </section>
    </section>

    <style>
        @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;700&display=swap");

        :root {
        --max-teal: #009999;
        --max-yellow: #ffcc00;
        --max-black: #111111;
        --max-white: #ffffff;
        --max-bg: #fcfcfc;
        --border-alt: #eeeeee;
        --accent-soft: rgba(0, 153, 153, 0.05);
        --font-main: "Space Grotesk", sans-serif;
        }

   .maximalist-hero,
.modern-content {
  font-family: var(--font-main);
  background-color: var(--max-bg);
}

        .noise-bg {
        position: absolute;
        inset: 0;
        z-index: 1;
        opacity: 0.04;
        pointer-events: none;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        }

        /* HERO */
        .maximalist-hero {
        height: 100vh;
        background-color: var(--max-white);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
        padding: 2rem;
        border-bottom: 1px solid var(--border-alt);
        }

        .floating-shape {
        position: absolute;
        z-index: 0;
        filter: blur(100px);
        border-radius: 50%;
        opacity: 0.4;
        }

        .shape-1 {
        width: 40vw;
        height: 40vw;
        background: var(--max-teal);
        top: -10%;
        right: -5%;
        animation: float-alt 10s infinite alternate;
        }

        .shape-2 {
        width: 30vw;
        height: 30vw;
        background: var(--max-yellow);
        bottom: -5%;
        left: -5%;
        animation: float-alt 8s infinite alternate-reverse;
        }

        .shape-3 {
        width: 25vw;
        height: 25vw;
        background: var(--max-teal);
        top: 20%;
        left: 10%;
        opacity: 0.15;
        animation: float-alt 12s infinite alternate;
        }

        .y2k-star {
        position: absolute;
        font-size: 2rem;
        color: var(--max-black);
        z-index: 2;
        pointer-events: none;
        user-select: none;
        }

        .star-1 {
        top: 15%;
        left: 15%;
        animation: rotate-star 4s linear infinite;
        }
        .star-2 {
        bottom: 20%;
        right: 15%;
        animation: rotate-star 6s linear infinite reverse;
        }

        @keyframes rotate-star {
        from { transform: rotate(0deg) scale(1); }
        50% { transform: rotate(180deg) scale(1.2); }
        to { transform: rotate(360deg) scale(1); }
        }

        @keyframes float-alt {
        from { transform: translate(0, 0) rotate(0deg); }
        to { transform: translate(30px, -30px) rotate(10deg); }
        }

        .hero-bg-text {
        position: absolute;
        font-size: 30vw;
        font-weight: 800;
        color: rgba(0, 0, 0, 0.02);
        z-index: 0;
        letter-spacing: -2vw;
        user-select: none;
        }

        .hero-content {
        position: relative;
        z-index: 5;
        text-align: center;
        }

        .hero-title {
        font-size: clamp(3rem, 14vw, 12rem);
        font-weight: 800;
        line-height: 0.8;
        letter-spacing: -0.05em;
        color: var(--max-black);
        margin-bottom: 2rem;
        }

        .reveal-text {
        display: inline-block;
        opacity: 0;
        transform: translateY(30px) skewY(5deg);
        transition: opacity 0.8s cubic-bezier(0.2, 0, 0.2, 1),
            transform 0.8s cubic-bezier(0.2, 0, 0.2, 1);
        transition-delay: var(--delay, 0s);
        }

        .reveal-text.active {
        opacity: 1;
        transform: translateY(0) skewY(0deg);
        }

        .italic { font-style: italic; font-weight: 300; }
        .vertical { font-size: 0.3em; letter-spacing: 0.5em; display: block; margin-top: 1rem; }

        .glitch-text {
        position: relative;
        display: inline-block;
        }

        .glitch-text::before,
        .glitch-text::after {
        content: attr(data-text);
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0.8;
        }

        .glitch-text:hover::before {
        animation: glitch-anim 0.3s infinite;
        color: var(--max-teal);
        z-index: -1;
        }

        .glitch-text:hover::after {
        animation: glitch-anim 0.3s infinite reverse;
        color: var(--max-yellow);
        z-index: -2;
        }

        @keyframes glitch-anim {
        0% { transform: translate(0); }
        20% { transform: translate(-3px, 3px); }
        40% { transform: translate(-3px, -3px); }
        60% { transform: translate(3px, 3px); }
        80% { transform: translate(3px, -3px); }
        100% { transform: translate(0); }
        }

        .hero-sticker {
        position: absolute;
        top: -20px;
        right: -40px;
        background: var(--max-black);
        color: white;
        padding: 0.5rem 1rem;
        font-size: 0.8rem;
        font-weight: 700;
        transform: rotate(15deg);
        border-radius: 50px;
        box-shadow: 5px 5px 0 var(--max-teal);
        transition: transform 0.3s ease;
        }

        .floating-sticker { animation: sticker-float 3s ease-in-out infinite; }

        @keyframes sticker-float {
        0%, 100% { transform: rotate(15deg) translateY(0); }
        50% { transform: rotate(10deg) translateY(-10px); }
        }

        .hero-subtitle {
        font-size: 0.9rem;
        font-weight: 400;
        letter-spacing: 0.3em;
        color: var(--max-teal);
        text-transform: uppercase;
        }

        /* CONTENT */
        .modern-content {
        background-color: var(--max-bg);
        padding: 10rem 2rem;
        position: relative;
        }

        .aesthetic-header {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        margin-bottom: 6rem;
        }

        .aesthetic-header .line {
        height: 1px;
        flex: 1;
        background: var(--border-alt);
        max-width: 100px;
        }

        .section-tag {
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.5em;
        color: var(--max-teal);
        }

        .modern-grid {
        max-width: 1300px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 2rem;
        }

        .modern-card {
        background: var(--max-white);
        border: 1px solid var(--border-alt);
        padding: 3rem;
        position: relative;
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .modern-card:hover {
        transform: scale(1.02);
        z-index: 10;
        box-shadow: 20px 20px 0 rgba(0, 153, 153, 0.05);
        }

        .card-header-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        }

        .aesthetic-dot {
        width: 8px;
        height: 8px;
        background: var(--max-teal);
        }

        .card-tag {
        font-size: 0.7rem;
        font-weight: 700;
        color: #bbb;
        letter-spacing: 0.2em;
        display: block;
        }

        .modern-title {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        margin-bottom: 2.5rem;
        color: var(--max-black);
        }

        .underline-aesthetic { position: relative; z-index: 1; }
        .underline-aesthetic::after {
        content: "";
        position: absolute;
        bottom: 5px;
        left: 0;
        width: 100%;
        height: 15px;
        background: var(--accent-soft);
        z-index: -1;
        }

        .text-outline-alt { -webkit-text-stroke: 1px var(--max-black); color: transparent; }

        .lead-modern { font-size: 1.2rem; line-height: 1.5; color: #444; margin-bottom: 2rem; }

        .name-badge-alt {
        padding: 0.4rem 1rem;
        border: 1px solid var(--max-black);
        font-weight: 700;
        font-size: 0.9rem;
        transition: all 0.3s;
        display: inline-block;
        margin: 0.2rem;
        }

        .name-badge-alt:hover { background: var(--max-black); color: white; }

        .purpose-item-alt { display: flex; gap: 1.5rem; margin-bottom: 3rem; }
        .item-id {
        width: 40px;
        height: 40px;
        border: 1px solid var(--max-black);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        flex-shrink: 0;
        }
        .item-id.yellow { background: var(--max-yellow); border: none; }
        .purpose-item-alt h3 { font-size: 0.9rem; font-weight: 800; margin-bottom: 0.5rem; }
        .purpose-item-alt p { font-size: 0.95rem; color: #666; line-height: 1.4; }

        .stat-highlight-alt { color: var(--max-teal); font-weight: 800; text-decoration: underline; }

        .stat-container { display: flex; align-items: baseline; gap: 0.5rem; margin-bottom: 1rem; }
        .stat-big-alt { font-size: 5rem; font-weight: 800; color: var(--max-teal); line-height: 1; }
        .stat-years { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.2em; color: #ccc; }

        .highlight-mini { background: var(--max-yellow); padding: 0 0.3rem; font-weight: 700; }
        .body-small-alt { font-size: 0.9rem; color: #888; line-height: 1.4; }

        .values-section { padding: 4rem !important; }
        .values-header-alt {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        border-bottom: 2px solid var(--max-teal);
        padding-bottom: 1.5rem;
        margin-bottom: 4rem;
        }
        .values-title-main {
        font-size: clamp(3rem, 8vw, 6.5rem);
        font-weight: 900;
        line-height: 0.9;
        margin: 0;
        letter-spacing: -0.05em;
        }
        .values-info-alt {
        display: flex;
        flex-direction: column;
        text-align: right;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        line-height: 1.6;
        }
        .values-grid-alt { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; }

        .value-card-alt {
        border: 1px solid var(--max-teal);
        aspect-ratio: 1 / 1;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        padding: 2rem;
        overflow: hidden;
        transition: all 0.4s ease;
        }
        .value-card-alt:hover { background: var(--accent-soft); box-shadow: inset 0 0 40px rgba(0, 153, 153, 0.05); }
        .value-ghost-text {
        position: absolute;
        font-size: 15rem;
        font-weight: 900;
        color: rgba(0, 153, 153, 0.02);
        z-index: 0;
        user-select: none;
        pointer-events: none;
        }
        .value-inner { position: relative; z-index: 1; text-align: center; }
        .value-tag-alt { font-size: 0.8rem; font-weight: 700; color: var(--max-teal); display: block; margin-bottom: 1.5rem; letter-spacing: 0.1em; }
        .value-name-alt { font-size: 2.2rem; font-weight: 800; margin-bottom: 1rem; letter-spacing: -0.02em; }
        .value-description-alt { font-size: 1rem; color: #666; max-width: 280px; margin: 0 auto; line-height: 1.5; }

        .policies-section { padding: 4rem 3rem !important; background: var(--max-white); overflow: hidden; }
        .policy-layout-alt { display: grid; grid-template-columns: 80px 1fr; gap: 3rem; margin-bottom: 3rem; }
        .policy-vertical-tag {
        writing-mode: vertical-rl;
        text-orientation: mixed;
        display: flex;
        justify-content: space-between;
        height: 100%;
        font-size: 0.7rem;
        font-weight: 700;
        color: #bbb;
        letter-spacing: 0.2em;
        border-left: 1px solid var(--border-alt);
        padding-left: 1rem;
        }
        .policy-header-alt { margin-bottom: 3rem; }
        .policy-line-top { display: block; width: 40px; height: 2px; background: var(--max-black); margin-bottom: 1.5rem; }
        .policy-title-alt {
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 900;
        line-height: 1.1;
        margin-bottom: 1rem;
        letter-spacing: -0.02em;
        }
        .policy-tagline-alt { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.4em; color: #999; text-transform: uppercase; }
        .policy-intro-alt { display: flex; gap: 2rem; margin-bottom: 3rem; align-items: flex-start; }
        .policy-id-box {
        width: 45px;
        height: 45px;
        border: 2px solid var(--max-teal);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 0.9rem;
        flex-shrink: 0;
        color: var(--max-teal);
        }
