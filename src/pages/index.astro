---
import LayoutBase from "@/layouts/LayoutBase.astro";
import "@/styles/styles.css";

import Bloque1 from "@/componentes/bloques/Bloque1.astro";
import Galeria from "@/componentes/bloques/Galeria.astro";
import Bloque5 from "@/componentes/bloques/Bloque5.astro";
import Bloque6 from "@/componentes/bloques/Bloque6.astro";
import Bloque7 from "@/componentes/bloques/Bloque7.astro";
import Bloque8 from "@/componentes/bloques/Bloque8.astro";
import Contacto from "@/componentes/principal/contacto.astro";
import Insides from "@/componentes/principal/Insides.astro";
import MasVisitadas from "@/componentes/principal/MasVisitadas.astro";
import Producciones from "@/componentes/principal/Producciones.astro";
import Programas from "@/componentes/principal/Programas.astro";
import Chatbot from "@/componentes/principal/Chatbot.astro";
---


<LayoutBase>
<!---Imagenes principales -->
<Galeria/>

<!---Seccion Tecnologia,salud,educacion -->
<Bloque1 
  categorias={["TECNOLOGIA", "SALUD", "EDUCACION"]} 
  titulo="TECNOLOGÍA, EDUCACIÓN Y SALUD" 
/>

<!--Seccion de Reportajes especiales -->
<Bloque5 
  categoria="REPORTAJES ESPECIALES"
  titulo="Reportajes Especiales"
  subtitulo="Exclusivo de NewsMX TV"
/>

<!--Seccion de LO MAS DESTACADO -->
<Bloque6
  categorias={["SEGURIDAD", "CLIMA Y MEDIO AMBIENTE", "POLITICA"]}
  titulo="LO MÁS DESTACADO"
/>

<!--Seccion de NACIONAL -->
<Bloque7
  categoria="NACIONAL"
  titulo="LOCAL"
  subtitulo="EDOMEX / CDMX / NACIONAL"
  linkMas="/noticias/categoria/nacional"
/>

<!--Seccion ENTERATE DEL CHISMESITO -->
<Bloque8
  categorias={["REDES SOCIALES", "DATOS EN ROJO"]}
  titulo="ENTERATE DEL CHISMESITO"
  subtitulo="Las noticias más relevantes"
/>
  
 <!--Producciones -->
<Producciones
/>

 <!--Programas -->
<Programas
/>

<!--Insides -->
<Insides
/>

<MasVisitadas
  titulo="NOTICIAS MÁS VISITADAS"
  categorias={[
    { nombre: "INTERNACIONAL", slug: "internacional" },
    { nombre: "DEPORTES", slug: "deportes" },
    { nombre: "ECONOMIA", slug: "economia" },
    { nombre: "NACIONAL", slug: "nacional" },
    { nombre: "TECNOLOGIA", slug: "tecnologia" },
  ]}
/>

<!--Contacto -->
<Contacto
/>

<!--Contacto -->
<Chatbot
/>








</LayoutBase>
