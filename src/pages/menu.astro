---
import "../styles/global.css";



import { actions } from "astro:actions";
import PlaceCard from "@/componentes/PlaceCard.astro";
import LayoutBase from "@/layouts/LayoutBase.astro";

// 🔥 Llamada correcta a la Action
const { data, error } = await Astro.callAction(actions.getPlaces,null);
const {data : newsData, error : newsError } = await Astro.callAction(actions.getAllNews, {});
console.log("News data:", newsData);

if (error) {
  throw error;
}

if (!data) {
  throw new Error("No data returned from getPlaces");
}

// tu action devuelve { data: places }
const places = data.data;
---

<LayoutBase>
  <h1 class="text-3xl font-extrabold">Lugares</h1>

  <div class="grid grid-cols-3 gap-4">
    {places.map((place) => (
      <PlaceCard place={place} />
    ))}
    <h1>back</h1>
  </div>
</LayoutBase>