---
import type { GetStaticPaths } from "astro";

import { getPlaceById, getPlacesForBuild } from "../../lib/place";

import { Image } from "astro:assets";

import Star from "@/componentes/Star.astro";
import LayoutBase from "@/layouts/LayoutBase.astro";
import Availability from "@/componentes/Availability.astro";

export const prerender = true;

export const getStaticPaths = (async () => {
    const places = await getPlacesForBuild();

    return places.map((place) => ({
        params: {
            id: place.id.toString(),
        },
    }));
}) satisfies GetStaticPaths;

const { id } = Astro.params;
const place = await getPlaceById(id);
if (!place) {
    throw new Error(`Place with id ${id} not found`);
}

const imageUrl = `/assets/assets/images/${place.image}`;
---

<LayoutBase>
    <div class="grid grid-cols-2 gap-2">
        <div class="bg-whit/80 p-5 rounded-xl">
            <h1 class=" text-2xl font-extrabold">#{id} {place.title}</h1>
            <p>{place.description}</p>
            <div class="flex flex-1">
                {
                    Array.from({ length: Number(place.avg_rating) }).map(
                        (_) => <Star />,
                    )
                }
            </div>

            <!--Todo: Server island -->
            <Availability server:defer  placeId={place.id.toString()} />

         
              <p class=" bg-gray-300 mt-5 text-center rounded-xl p-2 animate-pulse">Espere</p>



        </div>

        <div>
            <Image
            src={imageUrl}
            class = "w-full h96 object-cover rounded-xl"
            width="800"
            height="800"
            alt={place.title}
            />
        </div>
    </div>
</LayoutBase>
