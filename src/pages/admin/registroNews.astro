---
export const prerender = false;
import LayoutAdmin from "@/layouts/LayoutAdmin.astro";
import { actions } from "astro:actions";

let mensaje = "";

const { data } = await Astro.callAction(actions.getCategorias, null);

const categorias = data ?? [];
const user = Astro.cookies.get("user")?.json();
const esWebMaster = user?.rol === "3";
---

<LayoutAdmin>

  <!-- BOTONES FLOTANTES -->
  <div class="fixed bottom-6 right-6 flex flex-col gap-3 z-50">
    {esWebMaster && (
      <a href="/admin/CEO/menu" class="bg-[#0f4f4f] hover:bg-[#1f6f6f] text-white font-bold py-3 px-6 rounded-xl shadow-lg transition duration-300 text-center">
        MENU PRINCIPAL
      </a>
    )}
    <button id="btn-logout" class="bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-6 rounded-xl shadow-lg transition duration-300">
      CERRAR SESION
    </button>
  </div>

  <div class="min-h-screen bg-linear-to-br from-[#0f4f4f] to-[#2aa3a3] flex justify-center items-center p-6">
    <div class="bg-white w-full max-w-3xl rounded-2xl shadow-2xl p-10">

      <!-- HEADER -->
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-[#0f4f4f] tracking-wide">
          Registrar Nueva Noticia
        </h1>
        <p class="text-gray-500 mt-2">
          Publica contenido informativo para NEWSMX TV
        </p>
        <div class="w-20 h-1 bg-[#2aa3a3] mx-auto mt-4 rounded-full"></div>
      </div>

      <form class="space-y-6" method="POST" id="news-form">

        <!-- TÍTULO -->
        <div>
          <label class="block font-semibold text-[#0f4f4f] mb-2">TITULO</label>
          <input
            name="titulo"
            class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-[#2aa3a3] focus:border-[#2aa3a3] transition"
            placeholder="Titulo de la noticia"
          />
        </div>

        <!-- SLUG -->
        <div>
          <label class="block font-semibold text-[#0f4f4f] mb-2">SLUG</label>
          <input
            name="slug"
            class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-[#2aa3a3] focus:border-[#2aa3a3] transition"
            placeholder="slug-de-la-noticia"
          />
        </div>

        <!-- PRIMER PÁRRAFO -->
        <div>
          <label class="block font-semibold text-[#0f4f4f] mb-2">Primer Parrafo *</label>
          <textarea
            name="primer_parrafo"
            rows="3"
            class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-[#2aa3a3] focus:border-[#2aa3a3] transition"
            placeholder="Resumen breve"
          ></textarea>
        </div>

        <!-- CONTENIDO -->
        <div>
          <label class="block font-semibold text-[#0f4f4f] mb-2">Contenido *</label>
          <textarea
            name="contenido"
            rows="6"
            class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-[#2aa3a3] focus:border-[#2aa3a3] transition"
            placeholder="Contenido completo"
          ></textarea>
        </div>

        <!-- IMAGEN -->
        <div>
          <label class="block font-semibold text-[#0f4f4f] mb-2">URL Imagen *</label>
          <input
            type="file"
            accept="image/*"
            name="imagen"
            class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-[#2aa3a3] focus:border-[#2aa3a3] transition"
          />
        </div>

        <!-- CATEGORÍAS -->
        <div>
          <label class="block font-semibold text-[#0f4f4f] mb-3">Categorias *</label>
          <div
            class="border border-gray-200 rounded-xl p-4 h-44 overflow-y-auto bg-[#f4fafa]"
            id="categorias-container"
            data-categorias={JSON.stringify(categorias.map(c => c.nombre_categoria))}
          >
          </div>
        </div>

        <!-- BOTÓN SUBIR -->
        <div class="pt-4">
          <input
            id="submit-btn"
            type="submit"
            value="Subir Noticia"
            class="w-full bg-[#1f6f6f] hover:bg-[#0f4f4f] text-white py-3 rounded-xl font-semibold tracking-wide shadow-md transition duration-300 cursor-pointer"
          />
        </div>

        <!-- BOTÓN AGREGAR CATEGORÍA -->
        <div class="pt-4">
          <input
            id="submit-btn1"
            type="button"
            value="Gestionar Categorías"
            onclick="window.location.href='/admin/registroCategoria'"
            class="w-full bg-[#1f6f6f] hover:bg-[#0f4f4f] text-white py-3 rounded-xl font-semibold tracking-wide shadow-md transition duration-300 cursor-pointer"
          />
        </div>

        {mensaje && (
          <p class="text-center mt-4 font-medium text-[#0f4f4f]">{mensaje}</p>
        )}

      </form>
    </div>
  </div>

  <script>
    import { actions } from "astro:actions";
    import Swal from "sweetalert2";

    const form = document.getElementById('news-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    // Renderizar categorías desde data-attribute
    const container = document.getElementById("categorias-container")!;
    const categoriasData = JSON.parse(container.dataset.categorias!);
    categoriasData.forEach((nombre: string) => {
      const label = document.createElement("label");
      label.className = "flex items-center mb-2 cursor-pointer hover:bg-[#e6f7f7] p-2 rounded-lg transition";
      const input = document.createElement("input");
      input.type = "checkbox";
      input.name = "categorias";
      input.value = nombre;
      input.className = "mr-3 accent-[#2aa3a3] w-4 h-4";
      const span = document.createElement("span");
      span.className = "text-gray-700";
      span.textContent = nombre;
      label.appendChild(input);
      label.appendChild(span);
      container.appendChild(label);
    });

    async function comprimirImagen(file: File): Promise<File> {
      return new Promise((resolve) => {
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d')!;
        const img = new Image();
        const url = URL.createObjectURL(file);
        img.onload = () => {
          const MAX = 1200;
          let w = img.width;
          let h = img.height;
          if (w > MAX) { h = (h * MAX) / w; w = MAX; }
          if (h > MAX) { w = (w * MAX) / h; h = MAX; }
          canvas.width = w;
          canvas.height = h;
          ctx.drawImage(img, 0, 0, w, h);
          canvas.toBlob((blob) => {
            URL.revokeObjectURL(url);
            resolve(new File([blob!], file.name, { type: 'image/jpeg' }));
          }, 'image/jpeg', 0.8);
        };
        img.src = url;
      });
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const titulo = (document.querySelector('input[name="titulo"]') as HTMLInputElement).value.trim();
      const slug = (document.querySelector('input[name="slug"]') as HTMLInputElement).value.trim();
      const primerParrafo = (document.querySelector('textarea[name="primer_parrafo"]') as HTMLTextAreaElement).value.trim();
      const contenido = (document.querySelector('textarea[name="contenido"]') as HTMLTextAreaElement).value.trim();
      const imagenInput = (document.querySelector('input[name="imagen"]') as HTMLInputElement);
      const imagen = imagenInput.files;
      const categorias = document.querySelectorAll('input[name="categorias"]:checked');

      if (!titulo) {
        Swal.fire({ icon: "warning", title: "¡Falta llenar el título!", confirmButtonColor: "#0f4f4f" });
        return;
      }
      if (!slug) {
        Swal.fire({ icon: "warning", title: "¡Falta llenar el slug!", confirmButtonColor: "#0f4f4f" });
        return;
      }
      if (!primerParrafo) {
        Swal.fire({ icon: "warning", title: "¡Falta llenar el primer párrafo!", confirmButtonColor: "#0f4f4f" });
        return;
      }
      if (!contenido) {
        Swal.fire({ icon: "warning", title: "¡Falta llenar el contenido!", confirmButtonColor: "#0f4f4f" });
        return;
      }
      if (!imagen || imagen.length === 0) {
        Swal.fire({ icon: "warning", title: "¡Falta seleccionar una imagen!", confirmButtonColor: "#0f4f4f" });
        return;
      }
      if (categorias.length === 0) {
        Swal.fire({ icon: "warning", title: "¡Falta seleccionar una categoría!", confirmButtonColor: "#0f4f4f" });
        return;
      }

      submitBtn.disabled = true;

      Swal.fire({
        title: "Subiendo noticia...",
        text: "Por favor espera",
        allowOutsideClick: false,
        allowEscapeKey: false,
        didOpen: () => { Swal.showLoading(); }
      });

      try {
        const imagenComprimida = await comprimirImagen(imagen[0]);
        const formData = new FormData(form);
        formData.set('imagen', imagenComprimida, imagenComprimida.name);
        const { data: response, error } = await actions.addNews(formData);
        if (error) {
          Swal.fire({ icon: "error", title: "Error", text: error.message, confirmButtonColor: "#0f4f4f" });
        } else {
          Swal.fire({ icon: "success", title: "¡Noticia registrada!", text: "La noticia fue publicada con éxito.", confirmButtonColor: "#0f4f4f" })
            .then(() => { form.reset(); container.innerHTML = ""; categoriasData.forEach((nombre: string) => { const label = document.createElement("label"); label.className = "flex items-center mb-2 cursor-pointer hover:bg-[#e6f7f7] p-2 rounded-lg transition"; const input = document.createElement("input"); input.type = "checkbox"; input.name = "categorias"; input.value = nombre; input.className = "mr-3 accent-[#2aa3a3] w-4 h-4"; const span = document.createElement("span"); span.className = "text-gray-700"; span.textContent = nombre; label.appendChild(input); label.appendChild(span); container.appendChild(label); }); });
        }
      } catch (error) {
        Swal.fire({ icon: "error", title: "Error inesperado", text: "Ocurrió un error al registrar la noticia.", confirmButtonColor: "#0f4f4f" });
      } finally {
        submitBtn.disabled = false;
      }
    });

    document.getElementById("btn-logout")!.addEventListener("click", async () => {
      const confirmed = await Swal.fire({
        icon: "question",
        title: "¿Cerrar sesión?",
        text: "¿Estás seguro que deseas salir?",
        showCancelButton: true,
        confirmButtonText: "Sí, salir",
        cancelButtonText: "Cancelar",
        confirmButtonColor: "#dc2626",
        cancelButtonColor: "#0f4f4f",
      });
      if (!confirmed.isConfirmed) return;
      await actions.logout({});
      window.location.href = "/login";
    });
  </script>

</LayoutAdmin>