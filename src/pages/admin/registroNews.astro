---
import "@/styles/global.css";
import { actions } from "astro:actions";

let mensaje = "";

// ✅ SIEMPRE usar Astro.callAction en server
const { data } = await Astro.callAction(
  actions.getCategorias,
  null
);

const categorias = data ?? [];
// POST
if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const categoriasSeleccionadas = formData.getAll("categorias");

  if (categoriasSeleccionadas.length === 0) {
    mensaje = "Debes seleccionar al menos una categoría.";
  } else {
    const { error } = await Astro.callAction(
      actions.createNews,
      formData
    );

    if (error) {
      mensaje = "Error al guardar la noticia.";
    } else {
      mensaje = "Noticia creada correctamente.";
    }
  }
}
---



<div class="min-h-screen bg-gradient-to-br from-[#0f4f4f] to-[#2aa3a3] flex justify-center items-center p-6">

  <div class="bg-white w-full max-w-3xl rounded-2xl shadow-2xl p-10">

    <!-- HEADER -->
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-[#0f4f4f] tracking-wide">
        Registrar Nueva Noticia
      </h1>
      <p class="text-gray-500 mt-2">
        Publica contenido informativo para NEWSMX TV
      </p>
      <div class="w-20 h-1 bg-[#2aa3a3] mx-auto mt-4 rounded-full"></div>
    </div>

    <form class="space-y-6" method="POST">

      <!-- TÍTULO -->
      <div>
        <label class="block font-semibold text-[#0f4f4f] mb-2">
          TITULO
        </label>
        <input
          name="titulo"
          required
          class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-[#2aa3a3] focus:border-[#2aa3a3] transition"
          placeholder="Titulo de la noticia"
        />
      </div>

      <!-- PRIMER PÁRRAFO -->
      <div>
        <label class="block font-semibold text-[#0f4f4f] mb-2">
          Primer Parrafo *
        </label>
        <textarea
          name="primer_parrafo"
          required
          rows="3"
          class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-[#2aa3a3] focus:border-[#2aa3a3] transition"
          placeholder="Resumen breve"
        ></textarea>
      </div>

      <!-- CONTENIDO -->
      <div>
        <label class="block font-semibold text-[#0f4f4f] mb-2">
          Contenido *
        </label>
        <textarea
          name="contenido"
          required
          rows="6"
          class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-[#2aa3a3] focus:border-[#2aa3a3] transition"
          placeholder="Contenido completo"
        ></textarea>
      </div>

      <!-- IMAGEN -->
      <div>
        <label class="block font-semibold text-[#0f4f4f] mb-2">
          URL Imagen *
        </label>
        <input
          name="imagen"
          required
          class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-[#2aa3a3] focus:border-[#2aa3a3] transition"
          placeholder="https://..."
        />
      </div>

      <!-- CATEGORÍAS -->
      <div>
        <label class="block font-semibold text-[#0f4f4f] mb-3">
          Categorias *
        </label>

        <div class="border border-gray-200 rounded-xl p-4 h-44 overflow-y-auto bg-[#f4fafa]">

          {categorias && categorias.map(cat => (
            <label class="flex items-center mb-2 cursor-pointer hover:bg-[#e6f7f7] p-2 rounded-lg transition">
              <input
                type="checkbox"
                name="categorias"
                value={cat.id_categoria.toString()}
                class="mr-3 accent-[#2aa3a3] w-4 h-4"
              />
              <span class="text-gray-700">
                {cat.nombre_categoria}
              </span>
            </label>
          ))}

        </div>
      </div>

      <!-- BOTÓN -->
      <div class="pt-4">
        <button
          type="submit"
          class="w-full bg-[#1f6f6f] hover:bg-[#0f4f4f] text-white py-3 rounded-xl font-semibold tracking-wide shadow-md transition duration-300"
        >
          Guardar Noticia
        </button>
      </div>

      {mensaje && (
        <p class="text-center mt-4 font-medium text-[#0f4f4f]">
          {mensaje}
        </p>
      )}

    </form>

  </div>
</div>
