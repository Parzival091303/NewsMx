---
import LayoutBase from "@/layouts/LayoutBase.astro";
import CarrouselEquipo from "@/componentes/nosotros/CarrouselEquipo.astro";
/* Aqui se definen las imagenes y el nombre del miembro, el cual sera usado como texto alternativo. imageUrl corresponde a la URL de 
la imagen y nombre al nombre del miembro del equipo. Todo se define en el array de aqui abajo */
const redactores = [
    {imageUrl:"/img/equipo/redactores/alejandra-ramos-flores.webp", nombre:"Alejandra Ramos Flores"},
    {imageUrl:"/img/equipo/redactores/diana-zamorano.webp", nombre:"Diana Zamorano"},
    {imageUrl:"/img/equipo/redactores/itzel-zamorano.webp", nombre:"Itzel Zamorano"},
    {imageUrl:"/img/equipo/redactores/natali-uribe.webp", nombre: "Natali Uribe"}
    ]
---

<LayoutBase>
    <CarrouselEquipo
        datos={redactores},
        titulo="Nuestros redactores"
    ></CarrouselEquipo>
</LayoutBase>