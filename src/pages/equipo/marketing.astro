---
import LayoutBase from "@/layouts/LayoutBase.astro"
import CarrouselEquipo from "@/componentes/nosotros/CarrouselEquipo.astro"
/* Aqui se definen las imagenes y el nombre del miembro, el cual sera usado como texto alternativo. imageUrl corresponde a la URL de 
la imagen y nombre al nombre del miembro del equipo. Todo se define en el array de aqui abajo */
const marketing = [
    {imageUrl: "/img/equipo/marketing/victor-adan-santos-calva.webp", nombre: "Victor Adan Santos Calva"},
    {imageUrl: "/img/equipo/marketing/alonso-manqueros.webp", nombre: "Alonso Manqueros"},
    {imageUrl: "/img/equipo/marketing/aidee-saucedo.webp", nombre: "Aidee Saucedo"}
    ]
---
<LayoutBase>
    <CarrouselEquipo
        datos={marketing},
        titulo="Nuestro equipo de Marketing"
    ></CarrouselEquipo>
</LayoutBase>
