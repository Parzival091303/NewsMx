<script type="text/javascript">
  document.addEventListener('DOMContentLoaded', function() {
    const zoomConfigs = {};
    const editions = [1, 2, 3, 4, 5, 6, 7];
    
    // Inicializar configuraciones
    editions.forEach(edition => {
      zoomConfigs[edition] = {
        zoom: 1,
        minZoom: 0.5,
        maxZoom: 2,
        step: 0.1
      };
      loadSavedZoom(edition);
    });
    
    function applyZoom(edition) {
      const config = zoomConfigs[edition];
      const frames = document.querySelectorAll(`.magazine-frame[data-edition="${edition}"]`);
      const display = document.querySelector(`.zoom-level-display[data-edition="${edition}"]`);
      
      frames.forEach(frame => {
        frame.style.transform = `scale(${config.zoom})`;
        frame.style.transformOrigin = 'center center';
      });
      
      if (display) {
        display.textContent = Math.round(config.zoom * 100) + '%';
      }
      
      localStorage.setItem(`revista_zoom_${edition}`, config.zoom);
    }
    
    function loadSavedZoom(edition) {
      const saved = localStorage.getItem(`revista_zoom_${edition}`);
      if (saved) {
        zoomConfigs[edition].zoom = parseFloat(saved);
        applyZoom(edition);
      }
    }
    
    // Event listeners
    document.querySelectorAll('.zoom-in').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const edition = parseInt(this.getAttribute('data-edition'));
        const config = zoomConfigs[edition];
        if (config.zoom < config.maxZoom) {
          config.zoom = Math.min(config.maxZoom, config.zoom + config.step);
          applyZoom(edition);
        }
      });
    });
    
    document.querySelectorAll('.zoom-out').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const edition = parseInt(this.getAttribute('data-edition'));
        const config = zoomConfigs[edition];
        if (config.zoom > config.minZoom) {
          config.zoom = Math.max(config.minZoom, config.zoom - config.step);
          applyZoom(edition);
        }
      });
    });
    
    document.querySelectorAll('.zoom-reset').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const edition = parseInt(this.getAttribute('data-edition'));
        zoomConfigs[edition].zoom = 1;
        applyZoom(edition);
      });
    });
    
    // Loader timeout
    setTimeout(() => {
      document.querySelectorAll('.magazine-viewer.loading').forEach(container => {
        container.classList.remove('loading');
      });
    }, 5000);
  });
</script>