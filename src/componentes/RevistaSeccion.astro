  <script type="text/javascript">
  
        document.addEventListener('DOMContentLoaded', function() {
            const zoomConfigs = {};
            
            // Inicializar configuraciones de zoom para cada edición
            for (let i = 1; i <= 6; i++) {
                zoomConfigs[i] = {
                    zoom: 1,
                    minZoom: 0.6,
                    maxZoom: 1.5,
                    step: 0.1
                };
                loadSavedZoom(i);
            }
            
            // Aplicar zoom a un elemento específico
            function applyZoom(edition) {
                const config = zoomConfigs[edition];
                const elements = document.querySelectorAll(`[data-edition="${edition}"]`);
                const zoomLevel = document.querySelector(`.zoom-level[data-edition="${edition}"]`);
                
                elements.forEach(element => {
                    if (element.classList.contains('magazine-iframe')) {
                        element.style.transform = `scale(${config.zoom})`;
                    }
                });
                
                if (zoomLevel) {
                    zoomLevel.textContent = Math.round(config.zoom * 100) + "%";
                }
                
                // Guardar en localStorage
                localStorage.setItem(`newsMxZoom_${edition}`, config.zoom);
            }
            
            // Cargar zoom guardado
            function loadSavedZoom(edition) {
                const savedZoom = localStorage.getItem(`newsMxZoom_${edition}`);
                if (savedZoom) { 
                    zoomConfigs[edition].zoom = parseFloat(savedZoom); 
                    applyZoom(edition); 
                }
            }
            
            // Configurar eventos para botones de zoom
            document.querySelectorAll('.zoom-in').forEach(btn => {
                btn.addEventListener('click', function() {
                    const edition = parseInt(this.getAttribute('data-edition'));
                    const config = zoomConfigs[edition];
                    if (config.zoom < config.maxZoom) { 
                        config.zoom = Math.min(config.maxZoom, config.zoom + config.step); 
                        applyZoom(edition); 
                    }
                });
            });
            
            document.querySelectorAll('.zoom-out').forEach(btn => {
                btn.addEventListener('click', function() {
                    const edition = parseInt(this.getAttribute('data-edition'));
                    const config = zoomConfigs[edition];
                    if (config.zoom > config.minZoom) { 
                        config.zoom = Math.max(config.minZoom, config.zoom - config.step); 
                        applyZoom(edition); 
                    }
                });
            });
            
            document.querySelectorAll('.reset-zoom').forEach(btn => {
                btn.addEventListener('click', function() {
                    const edition = parseInt(this.getAttribute('data-edition'));
                    zoomConfigs[edition].zoom = 1; 
                    applyZoom(edition);
                });
            });
            
            // Control de carga para todos los iframes
            document.querySelectorAll('.magazine-iframe').forEach(iframe => {
                iframe.addEventListener('load', function() {
                    this.closest('.magazine-container').classList.remove('loading');
                });
                
                iframe.addEventListener('error', function() {
                    const container = this.closest('.magazine-container');
                    container.classList.remove('loading');
                    console.warn('Error al cargar la revista:', this.src);
                });
            });
            
            // Timeout de seguridad para quitar loading
            setTimeout(() => {
                document.querySelectorAll('.magazine-container.loading').forEach(container => {
                    container.classList.remove('loading');
                });
            }, 8000);
        });
    </script>
