<div class="producciones">

  <div class="prod-header">
    <h2>Producciones de NewsMX TV</h2>
    <hr />
  </div>

  <div class="prod-grid">
    {producciones.map((p) => (
      <a href={p.href} target="_blank" class="prod-card">
        <img src={p.img} alt={p.titulo} loading="lazy" />
        <div class="prod-overlay">
          <h3>{p.titulo}</h3>
          <span>NEWSMX TV</span>
        </div>
      </a>
    ))}
  </div>

</div>

<style>
  .producciones {
    background: white;
    max-width: 1100px;
    margin: 40px auto;
    padding: 30px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    border-radius: 4px;
    font-family: Arial, Helvetica, sans-serif;
  }

  .prod-header {
    text-align: center;
    margin-bottom: 20px;
  }

  .prod-header h2 {
    margin: 0;
    font-size: 1.5rem;
    color: #008b8b;
    font-weight: 600;
  }

  .prod-header hr {
    width: 60px;
    height: 2px;
    background: #008b8b;
    border: none;
    margin: 8px auto 0;
  }

  .prod-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .prod-card {
    position: relative;
    overflow: hidden;
    height: 130px;
    border-radius: 4px;
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .prod-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease, filter 0.3s ease;
    display: block;
  }

  .prod-card:hover img {
    transform: scale(1.05);
    filter: brightness(75%);
  }

  .prod-overlay {
    position: absolute;
    bottom: 0;
    width: 100%;
    padding: 8px 10px;
    background: linear-gradient(to top, rgba(0,0,0,0.75), transparent);
    color: white;
  }

  .prod-overlay h3 {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .prod-overlay span {
    font-size: 0.65rem;
    opacity: 0.85;
  }

  @media (max-width: 900px) {
    .prod-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .prod-grid { grid-template-columns: 1fr; }
    .prod-card { height: 160px; }
  }
</style>