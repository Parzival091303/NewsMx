---
// Componente ProgramasNMTV.astro
---

<div class="nmtv-wrapper">
  <div class="programas-container">

    <!-- HEADER -->
    <div class="header-nmtv">
      <h1>PROGRAMAS NMTV</h1>
      <p>Síguenos para ver nuestras transmisiones en vivo regulares</p>
    </div>

    <div class="divider-header"></div>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="main-content">

      <!-- VIDEO -->
      <div class="video-column">
        <iframe
          id="twitch-player"
          allowfullscreen
          scrolling="no"
          frameborder="0">
        </iframe>
      </div>

      <!-- CHAT -->
      <div class="chat-column">
        <div class="chat-header">
          <h2>💬 Chat del stream</h2>
          <p>¡Te damos la bienvenida a la sala de chat!</p>
        </div>

        <iframe
          id="twitch-chat"
          frameborder="0"
          scrolling="yes">
        </iframe>
      </div>

    </div>

  </div>
</div>

<style>
.nmtv-wrapper {
  width: 100%;
  min-height: 100vh;
  background: #f3f4f6;
  padding: 40px;
  font-family: Inter, sans-serif;
}

.programas-container {
  max-width: 1400px;
  margin: auto;
  background: white;
  border-radius: 12px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  overflow: hidden;
}

.header-nmtv {
  padding: 40px;
  text-align: center;
}

.header-nmtv h1 {
  font-size: 52px;
  font-weight: 800;
  color: #1e7f8c;
  margin: 0;
}

.header-nmtv p {
  font-size: 20px;
  color: #555;
  margin-top: 10px;
}

.divider-header {
  height: 2px;
  width: 120px;
  background: #d1d5db;
  margin: 0 auto 40px auto;
}

.main-content {
  display: flex;
  gap: 30px;
  padding: 0 40px 40px 40px;
}

.video-column {
  flex: 2;
  background: black;
  border-radius: 10px;
  overflow: hidden;
  min-height: 500px;
}

.video-column iframe {
  width: 100%;
  height: 100%;
}

.chat-column {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.chat-header {
  margin-bottom: 10px;
}

.chat-header h2 {
  margin: 0;
  font-size: 22px;
}

.chat-header p {
  margin: 5px 0 10px 0;
  font-size: 14px;
  color: #666;
}

.chat-column iframe {
  flex: 1;
  border-radius: 10px;
  min-height: 500px;
}

/* Responsive */
@media(max-width: 1024px){
  .main-content{
    flex-direction: column;
  }

  .video-column,
  .chat-column iframe{
    min-height: 400px;
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", () => {

  const domain = window.location.hostname;

  // PLAYER (tipado correcto)
  const player = document.getElementById("twitch-player") as HTMLIFrameElement | null;

  if (player) {
    player.src = `https://player.twitch.tv/?channel=newsmxtv&parent=${domain}&muted=false`;
  }

  // CHAT (tipado correcto)
  const chat = document.getElementById("twitch-chat") as HTMLIFrameElement | null;

  if (chat) {
    chat.src = `https://www.twitch.tv/embed/newsmxtv/chat?parent=${domain}`;
  }

});
</script>