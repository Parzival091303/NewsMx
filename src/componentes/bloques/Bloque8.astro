---
import { prisma } from "@/db";

interface Props {
  categorias?: string[];
  titulo?: string;
  subtitulo?: string;
}

const {
  categorias = ["Redes Sociales", "Datos en Rojo"],
  titulo = "ENTERATE DEL CHISMESITO",
  subtitulo = "Las noticias más relevantes"
} = Astro.props;

const todasNoticias = (await Promise.all(
  categorias.map(async (cat) => {
    const noticias = await prisma.noticias.findMany({
      where: {
        categorias: {
          some: { categoria: { nombre_categoria: cat } }
        }
      },
      include: {
        usuario: true,
        categorias: { include: { categoria: true } }
      },
      orderBy: { fecha_noticia: "desc" },
      take: 5
    });
    return noticias;
  })
)).flat();

// Agrupar en slides de 3
const slides: typeof todasNoticias[] = [];
for (let i = 0; i < todasNoticias.length; i += 3) {
  slides.push(todasNoticias.slice(i, i + 3));
}

function formatFecha(fecha: Date | null) {
  if (!fecha) return "";
  return new Date(fecha.getTime() + 6 * 60 * 60 * 1000).toLocaleDateString("es-MX", {
    day: "numeric", month: "long", year: "numeric"
  });
}

let contador = 0;
---

{todasNoticias.length > 0 && (
<div class="bloque8">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <div class="b8-container">
    <div class="b8-titulo">
      <h2>{titulo}</h2>
      <div class="b8-sub">{subtitulo}</div>
    </div>

    <div id="bloque8Carousel" class="carousel slide" data-bs-ride="carousel">
      <div class="carousel-inner">
        {slides.map((slide, si) => (
          <div class={`carousel-item ${si === 0 ? "active" : ""}`}>
            <div class="row g-4">
              {slide.map((n) => {
                contador++;
                const catNombre = n.categorias?.[0]?.categoria?.nombre_categoria ?? "";
                return (
                  <div class="col-md-4">
                    <a href={`/noticias/${n.noticias_url}`} class="b8-enlace">
                      <div class="b8-card">
                        <div class="b8-img-wrap">
                          <span class="b8-cat">{catNombre}</span>
                          <div class="b8-overlay"></div>
                          {n.imagen
                            ? <img src={n.imagen} alt={n.titulo_noticia ?? ""} loading="lazy" />
                            : <div class="b8-placeholder"><i class="fas fa-newspaper fa-2x"></i></div>
                          }
                          <span class="b8-counter">{contador}</span>
                        </div>
                        <div class="b8-corner b8-tl"></div>
                        <div class="b8-corner b8-br"></div>
                        <div class="b8-card-header">
                          <h3>{n.titulo_noticia}</h3>
                        </div>
                        <div class="b8-card-body">
                          <p>{n.primer_parrafo}</p>
                          <div class="b8-meta">
                            <span class="b8-autor">
                              <i class="fas fa-user-edit"></i>
                              {n.usuario ? `Por: ${n.usuario.nombre} ${n.usuario.apellido}` : "Redacción"}
                            </span>
                            <span class="b8-fecha">
                              <i class="far fa-calendar-alt"></i>
                              {formatFecha(n.fecha_noticia)}
                            </span>
                          </div>
                        </div>
                      </div>
                    </a>
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </div>

      <button class="carousel-control-prev" type="button" data-bs-target="#bloque8Carousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Anterior</span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#bloque8Carousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Siguiente</span>
      </button>
    </div>
  </div>
</div>
)}

<style>
  .bloque8 {
    background: linear-gradient(135deg, #f8f9fa 0%, #eef2f7 100%);
    padding: 50px 0 60px;
    position: relative;
    overflow: hidden;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  }

  .bloque8::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 15% 50%, rgba(26,188,156,0.05) 0%, transparent 20%),
      radial-gradient(circle at 85% 30%, rgba(44,62,80,0.05) 0%, transparent 20%);
    z-index: 0;
  }

  .b8-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
  }

  /* TÍTULO */
  .b8-titulo {
    text-align: center;
    margin-bottom: 50px;
  }

  .b8-titulo h2 {
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    font-weight: 800;
    letter-spacing: 1.5px;
    background: linear-gradient(135deg, #1abc9c 0%, #008080 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 8px;
    position: relative;
    display: inline-block;
  }

  .b8-titulo h2::after {
    content: '';
    position: absolute;
    bottom: -12px;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 4px;
    background: linear-gradient(135deg, #1abc9c, #008080);
    border-radius: 2px;
  }

  .b8-sub {
    color: #7f8c8d;
    font-size: 1rem;
    margin-top: 20px;
    font-weight: 300;
  }

  /* ENLACE */
  .b8-enlace {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  /* TARJETA */
  .b8-card {
    background: white;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    height: 100%;
    position: relative;
    transition: all 0.5s cubic-bezier(0.175,0.885,0.32,1.275);
    border: none;
  }

  .b8-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 5px;
    background: linear-gradient(135deg, #1abc9c, #008080);
    z-index: 2;
  }

  .b8-enlace:hover .b8-card {
    transform: translateY(-12px) scale(1.02);
    box-shadow: 0 20px 40px rgba(0,0,0,0.13);
  }

  /* IMAGEN */
  .b8-img-wrap {
    height: 220px;
    overflow: hidden;
    position: relative;
    background: #e2e8f0;
  }

  .b8-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }

  .b8-enlace:hover .b8-img-wrap img {
    transform: scale(1.1);
  }

  .b8-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, rgba(0,0,0,0.7) 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 1;
  }

  .b8-enlace:hover .b8-overlay { opacity: 1; }

  .b8-placeholder {
    width: 100%; height: 100%;
    background: linear-gradient(135deg, #2c3e50, #34495e);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
  }

  .b8-cat {
    position: absolute;
    top: 16px; left: 16px;
    background: rgba(26,188,156,0.95);
    color: white;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    z-index: 3;
    letter-spacing: 0.5px;
  }

  .b8-counter {
    position: absolute;
    bottom: 14px; right: 14px;
    background: rgba(44,62,80,0.9);
    color: white;
    width: 32px; height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 700;
    z-index: 3;
    border: 2px solid white;
  }

  /* CORNERS */
  .b8-corner {
    position: absolute;
    width: 26px; height: 26px;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .b8-tl { top: 12px; left: 12px; border-top: 2px solid #1abc9c; border-left: 2px solid #1abc9c; border-radius: 6px 0 0 0; }
  .b8-br { bottom: 12px; right: 12px; border-bottom: 2px solid #e74c3c; border-right: 2px solid #e74c3c; border-radius: 0 0 6px 0; }
  .b8-enlace:hover .b8-corner { opacity: 1; }

  /* CONTENIDO */
  .b8-card-header {
    padding: 20px 22px 12px;
  }

  .b8-card-header h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
    line-height: 1.4;
    min-height: 60px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    position: relative;
    padding-bottom: 12px;
    transition: color 0.2s;
  }

  .b8-enlace:hover .b8-card-header h3 { color: #008080; }

  .b8-card-header h3::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 44px; height: 3px;
    background: linear-gradient(135deg, #1abc9c, #008080);
    border-radius: 2px;
  }

  .b8-card-body {
    padding: 0 22px 22px;
  }

  .b8-card-body p {
    font-size: 0.85rem;
    color: #444;
    line-height: 1.6;
    margin-bottom: 16px;
    min-height: 80px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .b8-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 14px;
    border-top: 1px solid rgba(0,0,0,0.07);
    font-size: 0.78rem;
    flex-wrap: wrap;
    gap: 6px;
  }

  .b8-autor {
    font-weight: 600;
    color: #2c3e50;
  }
  .b8-autor i { margin-right: 5px; color: #1abc9c; }

  .b8-fecha { color: #7f8c8d; }
  .b8-fecha i { margin-right: 5px; color: #e74c3c; }

  /* CONTROLES */
  .carousel-control-prev, .carousel-control-next {
    width: 52px; height: 52px;
    background: white;
    border-radius: 50%;
    top: 50%; transform: translateY(-50%);
    opacity: 0.9;
    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    border: 2px solid #1abc9c;
    transition: all 0.3s ease;
  }

  .carousel-control-prev { left: -26px; }
  .carousel-control-next { right: -26px; }

  .carousel-control-prev-icon, .carousel-control-next-icon {
    width: 20px; height: 20px;
    filter: invert(48%) sepia(79%) saturate(2476%) hue-rotate(130deg) brightness(98%) contrast(104%);
  }

  .carousel-control-prev:hover, .carousel-control-next:hover {
    background: linear-gradient(135deg, #1abc9c, #008080);
    border-color: transparent;
    opacity: 1;
    transform: translateY(-50%) scale(1.1);
  }

  .carousel-control-prev:hover .carousel-control-prev-icon,
  .carousel-control-next:hover .carousel-control-next-icon {
    filter: invert(100%);
  }

  @media (max-width: 768px) {
    .b8-container { padding: 0 20px; }
    .carousel-control-prev { left: 0; }
    .carousel-control-next { right: 0; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const el = document.getElementById('bloque8Carousel');
    if (!el || typeof window === 'undefined') return;

    // @ts-ignore
    const carousel = new window.bootstrap.Carousel(el, {
      interval: 7000,
      wrap: true,
      touch: true
    });

    el.addEventListener('mouseenter', () => carousel.pause());
    el.addEventListener('mouseleave', () => carousel.cycle());
  });
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>