---
import { prisma } from "@/db";

interface Props {
  categorias: string[];
  titulo: string;
}

const { categorias, titulo } = Astro.props;

const noticias = await Promise.all(
  categorias.map(async (cat) => {
    const noticia = await prisma.noticias.findFirst({
      where: {
        categorias: {
          some: {
            categoria: { nombre_categoria: cat }
          }
        }
      },
      include: {
        usuario: true,
        categorias: { include: { categoria: true } }
      },
      orderBy: { fecha_noticia: "desc" }
    });
    return { categoria: cat, noticia };
  })
);

const principal = noticias[0];
const laterales = noticias.slice(1);

function formatFecha(fecha: Date | null) {
  if (!fecha) return "";
  return new Date(fecha.getTime() + 6 * 60 * 60 * 1000).toLocaleDateString("es-MX", {
    day: "numeric", month: "long", year: "numeric"
  });
}
---

<div class="bloque1">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700;800&display=swap" rel="stylesheet" />

  <div class="titulo-seccion">{titulo}</div>

  <div class="contenedor">

    <!-- CARD PRINCIPAL -->
    {principal?.noticia && (
      <a href={`/noticias/${principal.noticia.noticias_url}`} class="card-hero">
        <div class="hero-text">
          <span class="cat-label">{principal.categoria.toUpperCase()}</span>
          <h3 class="hero-titulo">{principal.noticia.titulo_noticia}</h3>
          <p class="hero-desc">{principal.noticia.primer_parrafo}</p>
          <div class="meta">
            {principal.noticia.usuario && (
              <span>Por {principal.noticia.usuario.nombre} {principal.noticia.usuario.apellido}</span>
            )}
            <span> · {formatFecha(principal.noticia.fecha_noticia)}</span>
          </div>
        </div>
        <div class="hero-img">
          <img src={principal.noticia.imagen ?? "/placeholder.jpg"} alt={principal.noticia.titulo_noticia ?? ""} />
        </div>
      </a>
    )}

    <!-- CARDS LATERALES -->
    <div class="laterales">
      {laterales.map(({ categoria, noticia }) => noticia && (
        <a href={`/noticias/${noticia.noticias_url}`} class="card-side">
          <div class="side-text">
            <span class="cat-label">{categoria.toUpperCase()}</span>
            <h4 class="side-titulo">{noticia.titulo_noticia}</h4>
            <div class="meta">
              {noticia.usuario && (
                <span>Por {noticia.usuario.nombre} {noticia.usuario.apellido}</span>
              )}
              <span> | {formatFecha(noticia.fecha_noticia)}</span>
            </div>
          </div>
          <div class="side-img">
            <img src={noticia.imagen ?? "/placeholder.jpg"} alt={noticia.titulo_noticia ?? ""} />
          </div>
        </a>
      ))}
    </div>

  </div>
</div>

<style>
  .bloque1 {
    max-width: 1100px;
    margin: 60px auto;
    padding: 0 20px 60px;
    font-family: 'Montserrat', sans-serif;
  }

  .titulo-seccion {
    text-align: center;
    font-size: 1.8rem;
    font-weight: 800;
    color: #008489;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 40px;
  }

  .titulo-seccion::after {
    content: "";
    display: block;
    width: 60px;
    height: 4px;
    background: #008489;
    margin: 10px auto 0;
    border-radius: 4px;
  }

  .contenedor {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 24px;
    align-items: start;
  }

  .cat-label {
    font-size: 10px;
    font-weight: 800;
    color: #008489;
    text-transform: uppercase;
    letter-spacing: 1px;
    display: block;
    margin-bottom: 8px;
  }

  .card-hero {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    text-decoration: none;
    color: inherit;
    display: flex;
    height: 100%;

    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .card-hero:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 30px rgba(0,132,137,0.15);
  }

  .hero-text {
    padding: 24px 24px 16px;
  }

  .hero-titulo {
    font-size: 1.3rem;
    font-weight: 700;
    color: #111;
    margin: 0 0 10px;
    line-height: 1.35;
    transition: color 0.2s;
  }

  .card-hero:hover .hero-titulo { color: #008489; }

  .hero-desc {
    font-size: 0.85rem;
    color: #555;
    line-height: 1.6;
    margin-bottom: 14px;
  }
.hero-img {
  width: 100%;
  flex: 1;
  overflow: hidden;
}

  .hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .card-hero:hover .hero-img img { transform: scale(1.04); }

  .laterales {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .card-side {
    background: white;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.07);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .card-side:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0,132,137,0.12);
  }

  .side-text {
    padding: 18px 18px 12px;
  }

  .side-titulo {
    font-size: 1rem;
    font-weight: 700;
    color: #111;
    margin: 0 0 8px;
    line-height: 1.35;
    transition: color 0.2s;
  }

  .card-side:hover .side-titulo { color: #008489; }

  .side-img {
    width: 100%;
    height: 160px;
    overflow: hidden;
  }

  .side-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .card-side:hover .side-img img { transform: scale(1.04); }

  .meta {
    font-size: 0.75rem;
    color: #888;
    margin-top: 4px;
  }

  @media (max-width: 768px) {
    .contenedor { grid-template-columns: 1fr; }
    .hero-img { height: 220px; }
  }
</style>