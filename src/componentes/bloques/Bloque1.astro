---
import { prisma } from "@/db";

interface Props {
  categoria: string;
  titulo: string;
}

const { categoria, titulo } = Astro.props;

// Traer las 3 noticias más recientes de la categoría
const noticias = await prisma.noticias.findMany({
  where: {
    categorias: {
      some: {
        categoria: {
          nombre_categoria: categoria
        }
      }
    }
  },
  include: {
    categorias: {
      include: { categoria: true }
    }
  },
  orderBy: { fecha_noticia: "desc" },
  take: 3
});

const principal = noticias[0] ?? null;
const laterales = noticias.slice(1);

function formatFecha(fecha: Date | null) {
  if (!fecha) return "";
  return new Date(fecha).toLocaleDateString("es-MX", {
    day: "numeric", month: "long", year: "numeric"
  });
}
---

{noticias.length > 0 && (
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700;800&display=swap" rel="stylesheet" />

<style>
  .custom-news-block * { box-sizing: border-box; }
  .cat-label {
    font-size: 10px; font-weight: 800; color: #008489;
    text-transform: uppercase; display: block; margin-bottom: 8px;
  }
  .titulo-seccion {
    text-align: center; font-size: 2em; font-weight: 800;
    color: #008489; margin-top: 50px; margin-bottom: 30px;
    text-transform: uppercase; letter-spacing: 1.5px;
    font-family: "Montserrat", sans-serif;
  }
  .titulo-seccion::after {
    content: ""; display: block; width: 60px; height: 4px;
    background-color: #008489; margin: 10px auto 0;
  }
  .contenedor-destacado {
    display: grid; grid-template-columns: 1.4fr 1fr;
    gap: 30px; max-width: 1100px; margin: 0 auto;
    padding: 0 20px 50px;
  }
  .card-hero, .card-side {
    transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  }
  .card-hero img, .card-side img {
    transition: transform 0.6s ease;
  }
  .news-title { transition: color 0.3s ease; }
  .card-hero:hover, .card-side:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 35px rgba(0, 132, 137, 0.15);
  }
  .card-hero:hover img, .card-side:hover img { transform: scale(1.05); }
  .card-hero:hover .news-title, .card-side:hover .news-title { color: #008489; }
  .card-hero {
    display: flex; flex-direction: column; background: white;
    border-radius: 12px; overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1); height: 100%;
    text-decoration: none; color: inherit;
  }
  .hero-text-content {
    padding: 25px 25px 15px 25px; background: white;
    order: 1; z-index: 2; position: relative;
  }
  .hero-img-wrapper { height: 350px; width: 100%; order: 2; overflow: hidden; }
  .hero-img-wrapper img { width: 100%; height: 100%; object-fit: cover; }
  .lista-lateral { display: flex; flex-direction: column; gap: 20px; }
  .card-side {
    display: block; background: white; border-radius: 10px;
    overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    text-decoration: none; color: inherit;
  }
  .side-text-content {
    padding: 20px 20px 10px 20px; background: white;
    position: relative; z-index: 2;
  }
  .side-img-wrapper { width: 100%; height: 180px; display: block; overflow: hidden; }
  .side-img-wrapper img { width: 100%; height: 100%; object-fit: cover; }
  .news-title {
    font-size: 18px; font-weight: 700; color: #222;
    margin: 0 0 10px 0; line-height: 1.3;
    font-family: "Montserrat", sans-serif;
  }
  .hero-title { font-size: 24px; }
  .news-desc { font-size: 13px; color: #555; margin-bottom: 15px; line-height: 1.5; }
  .news-meta {
    font-size: 11px; color: #888;
    border-top: 1px solid #eee; padding-top: 8px; margin-top: 10px;
  }
  @media (max-width: 900px) {
    .contenedor-destacado { grid-template-columns: 1fr; }
    .hero-img-wrapper { height: 250px; }
  }
</style>

<div class="custom-news-block">
  <div class="titulo-seccion">{titulo}</div>

  <div class="contenedor-destacado">
    {principal && (
      <a href={`/noticias/${principal.noticias_url}`} class="card-hero">
        <div class="hero-text-content">
          <span class="cat-label">{categoria.toUpperCase()}</span>
          <h3 class="news-title hero-title">{principal.titulo_noticia}</h3>
          <p class="news-desc">{principal.primer_parrafo}</p>
          <div class="news-meta">{formatFecha(principal.fecha_noticia)}</div>
        </div>
        <div class="hero-img-wrapper">
          <img src={principal.imagen ?? "/placeholder.jpg"} alt={principal.titulo_noticia ?? ""} />
        </div>
      </a>
    )}

    <div class="lista-lateral">
      {laterales.map((n) => (
        <a href={`/noticias/${n.noticias_url}`} class="card-side">
          <div class="side-text-content">
            <span class="cat-label">{categoria.toUpperCase()}</span>
            <h4 class="news-title">{n.titulo_noticia}</h4>
            <div class="news-meta">{formatFecha(n.fecha_noticia)}</div>
          </div>
          <div class="side-img-wrapper">
            <img src={n.imagen ?? "/placeholder.jpg"} alt={n.titulo_noticia ?? ""} />
          </div>
        </a>
      ))}
    </div>
  </div>
</div>
)}