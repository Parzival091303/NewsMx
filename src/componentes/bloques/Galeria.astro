---
const heroImage = "/img/Galeria/principal.png";

const cards = [
  {
    imagen: "/img/Galeria/abajao-izquierda.png",
    titulo: "Podcast",
    href: "/podcats",
  },
  {
    imagen: "/img/Galeria/abajao-centro.png",
    titulo: "NewsMx TV",
    href: "/nosotros",
  },
  {
    imagen: "/img/Galeria/abajao-derecha.png",
    titulo: "Sección de Noticias",
    href: "/noticias/categoria/noticiasPrincipal",
  },
];
---

<section class="galeria">

  <!-- HERO -->
  <div class="hero" style={`background-image: url('${heroImage}')`}>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1 class="hero-titulo">
        NewsMx Tv® tu<br />
        fuente de noticias y<br />
        entretenimiento.
      </h1>
      <p class="hero-sub">Actualidad y análisis en medios digitales</p>
      <a href="/noticias/categoria/noticiasPrincipal" class="hero-btn">
        EXPLORA NUESTRAS NOTICIAS
      </a>
    </div>
  </div>

  <!-- TARJETAS -->
  <div class="cards-grid">
    {cards.map((card) => (
      <a href={card.href} class="card">
        <img src={card.imagen} alt={card.titulo} />
        <div class="card-overlay">
          <span class="card-titulo">{card.titulo}</span>
        </div>
      </a>
    ))}
  </div>

</section>

<style>
  .galeria {
    width: 100%;
    font-family: 'Montserrat', sans-serif;
  }

  /* HERO */
  .hero {
    position: relative;
    width: 100%;
    min-height: 340px;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }

.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.2), rgba(0,0,0,0.35));
}

.hero-content {
  position: relative;
  z-index: 2;
  text-align: center;
  color: white;
  padding: 0 20px;
  max-width: 800px;
  background: none;
}

  .hero-titulo {
    font-size: clamp(1.2rem, 3vw, 2rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 20px;
    text-shadow: 0 2px 20px rgba(0,0,0,0.5);
    letter-spacing: -0.5px;
  }

  .hero-sub {
   font-size: 0.95rem;
    opacity: 0.9;
    margin-bottom: 32px;
    font-weight: 400;
  }

  .hero-btn {
    display: inline-block;
    background: #008489;
    color: white;
    padding: 16px 36px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-decoration: none;
    transition: background 0.3s ease, transform 0.2s ease;
  }

  .hero-btn:hover {
    background: #006e73;
    transform: translateY(-2px);
  }

  /* TARJETAS */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    width: 100%;
  }

  .card {
    position: relative;
    overflow: hidden;
    height: 200px;
    display: block;
    text-decoration: none;
  }

  .card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .card:hover img {
    transform: scale(1.06);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.65), transparent);
    display: flex;
    align-items: flex-end;
    padding: 20px;
    transition: background 0.3s ease;
  }

  .card:hover .card-overlay {
    background: linear-gradient(to top, rgba(0,132,137,0.7), transparent);
  }

  .card-titulo {
    color: white;
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-shadow: 0 2px 8px rgba(0,0,0,0.4);
  }

  @media (max-width: 768px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
    .card {
      height: 220px;
    }
    .hero {
      min-height: 380px;
    }
  }
</style>