<section class="ad-artisticas">
    <div class="art-container">
        <div class="art-deco-bg">
            <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                <path fill="rgba(0, 153, 153, 0.1)" d="M40,-68.2C53.3,-60.1,66.5,-51,75.1,-38.4C83.7,-25.8,87.7,-9.7,85.6,5.6C83.5,20.8,75.3,35.1,64.8,47.1C54.3,59.1,41.5,68.8,27.3,73.8C13.1,78.8,-2.5,79.1,-17.7,75.4C-32.9,71.7,-47.7,64.1,-59.4,52.8C-71.1,41.5,-79.7,26.5,-82.8,10.4C-85.9,-5.7,-83.5,-22.9,-75.4,-37.2C-67.3,-51.5,-53.5,-62.9,-39.2,-70.5C-24.9,-78.1,-10.1,-81.9,2.4,-86.1C14.9,-90.3,26.7,-76.3,40,-68.2Z" transform="translate(100 100)" />
            </svg>
        </div>

        <div class="art-content">
            <div class="art-header">
                <div class="art-badge">TALENTO EXCLUSIVO</div>
                <div class="art-icon-svg">
                    <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="50" cy="50" r="45" fill="none" stroke="#009999" stroke-width="1" stroke-dasharray="5,5"/>
                        <path d="M30 50 Q50 20 70 50 T110 50" fill="none" stroke="#009999" stroke-width="3">
                            <animate attributeName="d" dur="5s" repeatCount="indefinite" values="M30 50 Q50 20 70 50 T110 50; M30 50 Q50 80 70 50 T110 50; M30 50 Q50 20 70 50 T110 50"/>
                        </path>
                        <rect x="45" y="45" width="10" height="10" fill="#1a1a1a" stroke="#009999" stroke-width="2" transform="rotate(45 50 50)"/>
                    </svg>
                </div>
            </div>

            <h2 class="art-title">ESPECIALIDADES <br/><span class="outline">ARTÍSTICAS</span></h2>
            <p class="art-description">
                Donde el talento encuentra su escenario. Agencia líder en representación, 
                formación y producción creativa para artistas de alto impacto.
            </p>

            <div class="art-footer">
                <div class="art-stats">
                    <span class="stat-item">CREATIVIDAD SIN LÍMITES</span>
                </div>
                <a href="#" class="art-btn">EXPLORAR TALENTO</a>
            </div>
        </div>

        <div class="art-visual">
            <div class="visual-box">
                <span class="visual-text">CREATIVE</span>
                <span class="visual-text">AGENCY</span>
            </div>
        </div>
    </div>
</section>

<style>
    .ad-artisticas {
        background-color: #ffffff;
        padding: 4rem 2rem;
        margin: 4rem 0;
        position: relative;
        overflow: hidden;
        border: 10px solid #1a1a1a;
    }

    .art-container {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 4rem;
        align-items: center;
        position: relative;
    }

    .art-deco-bg {
        position: absolute;
        top: -50%;
        left: -20%;
        width: 100%;
        z-index: 0;
        opacity: 0.5;
        pointer-events: none;
    }

    .art-content {
        position: relative;
        z-index: 2;
    }

    .art-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

    .art-badge {
        background: #1a1a1a;
        color: #009999;
        padding: 0.4rem 1.2rem;
        font-weight: 900;
        font-size: 0.8rem;
        letter-spacing: 3px;
    }

    .art-icon-svg {
        width: 90px;
        height: 90px;
    }

    .art-title {
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 900;
        line-height: 0.85;
        color: #1a1a1a;
        margin-bottom: 1.5rem;
        text-transform: uppercase;
        letter-spacing: -2px;
    }

    .art-title .outline {
        color: transparent;
        -webkit-text-stroke: 2px #1a1a1a;
    }

    .art-description {
        font-size: 1.2rem;
        color: #444;
        line-height: 1.5;
        margin-bottom: 2.5rem;
        max-width: 550px;
        position: relative;
    }

    .art-description::before {
        content: '';
        position: absolute;
        left: -20px;
        top: 0;
        width: 5px;
        height: 100%;
        background: #009999;
    }

    .art-footer {
        display: flex;
        gap: 2rem;
        align-items: center;
    }

    .art-stats {
        font-weight: 800;
        font-size: 0.9rem;
        color: #1a1a1a;
        letter-spacing: 1px;
    }

    .art-btn {
        background: #009999;
        color: white;
        padding: 1.2rem 3rem;
        font-weight: 900;
        text-decoration: none;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: 3px solid #009999;
    }

    .art-btn:hover {
        background: transparent;
        color: #009999;
        transform: scale(1.05) rotate(-2deg);
    }

    .art-visual {
        position: relative;
        height: 300px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #f0f0f0;
        border: 4px dashed #ccc;
    }

    .visual-box {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .visual-text {
        font-size: 3.5rem;
        font-weight: 900;
        line-height: 0.8;
        color: rgba(26, 26, 26, 0.1);
        text-transform: uppercase;
    }

    @media (max-width: 900px) {
        .art-container { grid-template-columns: 1fr; }
        .art-visual { display: none; }
        .art-footer { flex-direction: column; align-items: flex-start; }
    }
</style>